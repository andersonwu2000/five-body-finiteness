import Mathlib.Tactic

namespace CentralConfigurations.FiveBody.D2.Exceptional
noncomputable section
set_option maxHeartbeats 2000000

def P0 (h y : ℂ) : ℂ := y^5 + y^4*(-h - 1) + y^3*(3*h/2 - 3/2) + y^2*(2 - 3*h) + y*(5*h/2 - 19/2)
def Pc0 (h y : ℂ) : ℂ := y^4*(-5*h/2 - 19/2) + y^3*(3*h + 2) + y^2*(-3*h/2 - 3/2) + y*(h - 1) + 1
def U0 (h y : ℂ) : ℂ := 2035*h/27396 + y^3*(-12073*h/27396 - 18017/27396) + y^2*(6425*h/20547 - 35/2283) + y*(-3181*h/20547 - 155/13698) - 5617/27396
def V0 (h y : ℂ) : ℂ := y^4*(-71*h/3044 - 2401/27396) + y^3*(4553*h/41094 + 134/6849) + y^2*(541/2283 - 1997*h/20547) + y*(1993*h/9132 - 10703/27396) + 1

theorem bezout0 (h y : ℂ) (hh : h^2+3=0) :
    U0 h y*P0 h y+V0 h y*Pc0 h y = 1 := by
  dsimp [U0,P0,V0,Pc0]
  linear_combination (355*y^8/6088 + 7703*y^7/82188 - 9955*y^6/27396 + 151097*y^5/164376 - 235879*y^4/164376 + 12781*y^3/13698 - 8047*y^2/20547 + 10175*y/54792)*hh

def P1 (h y : ℂ) : ℂ := 3*h + y^5 + y^4*(-h - 1) + y^3*(3*h/2 - 3/2) - y^2 + y*(-7*h/2 - 7/2) - 3
def Pc1 (h y : ℂ) : ℂ := y^5*(-3*h - 3) + y^4*(7*h/2 - 7/2) - y^3 + y^2*(-3*h/2 - 3/2) + y*(h - 1) + 1
def U1 (h y : ℂ) : ℂ := -1261*h/24624 - 559*y^4/2052 + y^3*(1831*h/24624 + 1831/24624) + y^2*(227*h/4104 - 227/4104) - 949*y/4104 - 1261/24624
def V1 (h y : ℂ) : ℂ := y^4*(559*h/24624 - 559/24624) + 257*y^3/4104 + y^2*(-11*h/216 - 11/216) + y*(1237/24624 - 1237*h/24624) + 791/2052

theorem bezout1 (h y : ℂ) (hh : h^2+3=0) :
    U1 h y*P1 h y+V1 h y*Pc1 h y = 1 := by
  dsimp [U1,P1,V1,Pc1]
  linear_combination (-559*y^9/8208 + 3913*y^8/49248 + 1931*y^7/24624 - 11*y^6/2052 - 3455*y^5/49248 - 6533*y^4/49248 - 47*y^3/2052 + 2849*y^2/24624 + 8827*y/49248 - 1261/8208)*hh

def P2 (h y : ℂ) : ℂ := -3*h + y^5 + y^4*(-h - 1) + y^3*(3*h/2 - 3/2) + 5*y^2 + y*(5*h/2 + 5/2) + 3
def Pc2 (h y : ℂ) : ℂ := y^5*(3*h + 3) + y^4*(5/2 - 5*h/2) + 5*y^3 + y^2*(-3*h/2 - 3/2) + y*(h - 1) + 1
def U2 (h y : ℂ) : ℂ := 190*h/729 + y^3*(205*h/243 - 205/243) + 1271*y^2/729 + y*(-112*h/729 - 112/729) - 190/729
def V2 (h y : ℂ) : ℂ := -517*h/486 + y^3*(-205*h/1458 - 205/1458) + y^2*(451*h/1458 - 451/1458) + 871*y/729 - 517/486

theorem bezout2 (h y : ℂ) (hh : h^2+3=0) :
    U2 h y*P2 h y+V2 h y*Pc2 h y = h/2 + y + 1/2 := by
  dsimp [U2,P2,V2,Pc2]
  linear_combination (-205*y^8/486 + 1271*y^7/2916 + 1435*y^6/2916 - 8243*y^5/2916 + 595*y^4/162 - 2669*y^3/1458 + 3533*y^2/2916 + 71*y/1458 - 190/243)*hh

def P3 (h y : ℂ) : ℂ := y^5 + y^4*(-h - 1) + y^3*(3*h/2 - 3/2) + y^2*(3*h + 2) + y*(17/2 - 7*h/2)
def Pc3 (h y : ℂ) : ℂ := y^4*(7*h/2 + 17/2) + y^3*(2 - 3*h) + y^2*(-3*h/2 - 3/2) + y*(h - 1) + 1
def U3 (h y : ℂ) : ℂ := -199*h/3044 + y^3*(-5015*h/9132 - 9101/27396) + y^2*(3370*h/20547 - 3160/6849) + y*(3181*h/20547 - 155/13698) + 5861/27396
def V3 (h y : ℂ) : ℂ := y^4*(881*h/27396 + 2159/27396) + y^3*(134/6849 - 4553*h/41094) + y^2*(1436*h/20547 - 1810/6849) + y*(8341*h/27396 - 3617/27396) + 1

theorem bezout3 (h y : ℂ) (hh : h^2+3=0) :
    U3 h y*P3 h y+V3 h y*Pc3 h y = 1 := by
  dsimp [U3,P3,V3,Pc3]
  linear_combination (6167*y^8/54792 + 5335*y^7/82188 - 12575*y^6/27396 - 82517*y^5/164376 + 260161*y^4/164376 - 8143*y^3/13698 - 17815*y^2/41094 + 1393*y/6088)*hh

end
end CentralConfigurations.FiveBody.D2.Exceptional
