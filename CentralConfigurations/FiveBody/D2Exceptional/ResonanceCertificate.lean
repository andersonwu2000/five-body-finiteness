import Mathlib.Tactic

namespace CentralConfigurations.FiveBody.D2.Exceptional
set_option maxHeartbeats 4000000

def F1 (u v r : ℝ) : ℝ := -2*r*u + 2*r - u^2 + 4*u - 2*v - 3
def F2 (u v r : ℝ) : ℝ := r*u^2 - 3*r*v^2 + 2*r*v - 4*r + 2*u*v - 8*u + 10
def F3 (u v r : ℝ) : ℝ := 2*r*u*v - 3*r*v^2 - r - 2*u + v^2 + 3
def R10 (r : ℝ) : ℝ := 27*r^10 - 60*r^9 + 54*r^8 + 104*r^7 - 247*r^6 + 144*r^5 + 78*r^4 - 60*r^3 - 45*r^2 + 40*r - 8

theorem coefficient_elimination (u v r : ℝ) (h1 : F1 u v r=0) (h2 : F2 u v r=0) (h3 : F3 u v r=0) :
    (r-2)*R10 r=0 := by
  dsimp [F1,F2,F3] at h1 h2 h3
  dsimp [R10]
  linear_combination (-27*r^10*u/4 + 27*r^10*v/2 - 27*r^10/4 - 9*r^9*u*v/4 + 39*r^9*u/2 + 9*r^9*v^2/2 - 105*r^9*v/2 + 267*r^9/4 - 15*r^8*u*v - 75*r^8*u/4 + 27*r^8*v^2 + 63*r^8*v - 561*r^8/4 + 87*r^7*u*v/4 - 89*r^7*u/4 - 63*r^7*v^2 + 121*r^7*v + 73*r^7 - 115*r^6*u*v/4 + 401*r^6*u/4 + 90*r^6*v^2 - 817*r^6*v/2 + 523*r^6/2 - 251*r^5*u*v/4 - 231*r^5*u/4 + 167*r^5*v^2/2 + 823*r^5*v/2 - 1241*r^5/2 + 589*r^4*u*v/4 - 17*r^4*u - 373*r^4*v^2 + 313*r^4*v + 961*r^4/4 - 207*r^3*u*v/2 + 71*r^3*u/4 + 419*r^3*v^2 - 914*r^3*v + 1331*r^3/4 + 125*r^2*u*v/4 - 2*r^2*u - 228*r^2*v^2 + 1359*r^2*v/2 - 1369*r^2/4 - 7*r*u*v/2 - r*u/2 + 125*r*v^2/2 - 439*r*v/2 + 233*r/2 - 7*v^2 + 27*v - 14)*h1 +
    (-27*r^10/2 - 27*r^9*u/4 - 9*r^9*v/2 + 237*r^9/4 - 9*r^8*u*v/4 + 39*r^8*u/2 - 39*r^8*v/2 - 357*r^8/4 - 15*r^7*u*v - 75*r^7*u/4 + 72*r^7*v + 23*r^7/4 + 87*r^6*u*v/4 - 89*r^6*u/4 - 121*r^6*v + 509*r^6/2 - 115*r^5*u*v/4 + 401*r^5*u/4 - 25*r^5*v/2 - 773*r^5/2 - 251*r^4*u*v/4 - 231*r^4*u/4 + 581*r^4*v/2 + 315*r^4/2 + 589*r^3*u*v/4 - 17*r^3*u - 396*r^3*v + 657*r^3/4 - 207*r^2*u*v/2 + 71*r^2*u/4 + 248*r^2*v - 843*r^2/4 + 125*r*u*v/4 - 2*r*u - 153*r*v/2 + 343*r/4 - 7*u*v/2 - u/2 + 19*v/2 - 25/2)*h2 +
    (27*r^10/2 + 27*r^9*u/4 + 9*r^9*v/2 - 255*r^9/4 + 9*r^8*u*v/4 - 81*r^8*u/4 + 18*r^8*v + 207*r^8/2 + 63*r^7*u*v/4 + 21*r^7*u - 84*r^7*v - 137*r^7/4 - 33*r^6*u*v/2 + 93*r^6*u/4 + 135*r^6*v - 1217*r^6/4 + 93*r^5*u*v/4 - 221*r^5*u/2 - 5*r^5*v/2 + 2059*r^5/4 + 141*r^4*u*v/2 + 565*r^4*u/4 - 347*r^4*v - 1595*r^4/4 - 495*r^3*u*v/4 - 665*r^3*u/4 + 529*r^3*v - 235*r^3/2 + 249*r^2*u*v/4 + 279*r^2*u/2 - 351*r^2*v + 1501*r^2/4 - 21*r*u*v/2 - 115*r*u/2 + 223*r*v/2 - 195*r + 9*u - 14*v + 33)*h3

theorem R10_shift (r : ℝ) : R10 r = 27*(r-1)^10 + 210*(r-1)^9 + 729*(r-1)^8 + 1616*(r-1)^7 + 2623*(r-1)^6 + 3114*(r-1)^5 + 2623*(r-1)^4 + 1616*(r-1)^3 + 729*(r-1)^2 + 210*(r-1) + 27 := by dsimp [R10]; ring

end CentralConfigurations.FiveBody.D2.Exceptional
