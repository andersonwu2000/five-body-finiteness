set_option maxHeartbeats 3000000 in
theorem kite_elimination_certificate {R : Type*} [CommRing R] (a b c t : R) :
    kiteMassPolynomial a b c * kitePositiveQuartic a b c *
      kitePositiveQuartic b a c * kitePositiveQuartic c a b =
    KiteCertificate.U a b c t * kiteSeparationEquation a b c t +
      KiteCertificate.V a b c t * kiteBalanceEquation a b c t := by
  dsimp [kiteMassPolynomial, triangleMassPolynomial, kiteMu6, kiteMu15,
    kitePositiveQuartic, KiteCertificate.U, KiteCertificate.V,
    KiteCertificate.U0, KiteCertificate.U1, KiteCertificate.U2, KiteCertificate.U3, KiteCertificate.V0, KiteCertificate.V1, KiteCertificate.V2, KiteCertificate.V3, KiteCertificate.V4, KiteCertificate.V5,
    kiteSeparationEquation, kiteBalanceEquation]
  ring

theorem kite_mass_polynomial_of_equations (a b c : ℝ)
    (ha : 0 < a) (hb : 0 < b) (hc : 0 < c) (t : ℂ)
    (hF : kiteSeparationEquation (a : ℂ) (b : ℂ) (c : ℂ) t = 0)
    (hG : kiteBalanceEquation (a : ℂ) (b : ℂ) (c : ℂ) t = 0) :
    kiteMassPolynomial a b c = 0 := by
  have he := kite_elimination_certificate (a : ℂ) (b : ℂ) (c : ℂ) t
  rw [hF, hG, mul_zero, mul_zero, add_zero] at he
  have hr : kiteMassPolynomial a b c * kitePositiveQuartic a b c *
      kitePositiveQuartic b a c * kitePositiveQuartic c a b = 0 := by
    dsimp [kiteMassPolynomial, triangleMassPolynomial, kiteMu6, kiteMu15,
      kitePositiveQuartic] at he ⊢
    exact_mod_cast he
  have hQ1 := ne_of_gt (kite_positive_quartic_pos a b c ha hb hc)
  have hQ2 := ne_of_gt (kite_positive_quartic_pos b a c hb ha hc)
  have hQ3 := ne_of_gt (kite_positive_quartic_pos c a b hc ha hb)
  exact (mul_eq_zero.mp ((mul_eq_zero.mp ((mul_eq_zero.mp hr).resolve_right hQ3)).resolve_right hQ2)).resolve_right hQ1

end CentralConfigurations
